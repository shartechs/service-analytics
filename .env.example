# Copy to .env.local for local development (Next.js loads .env.local automatically).
# These defaults match docker-compose.yml.

POSTGRES_USER=khma
POSTGRES_PASSWORD=khma_dev_password
POSTGRES_DB=khma
POSTGRES_PORT=5432

# Connection string the Next.js app uses (lib/db.ts reads this).
DATABASE_URL=postgresql://khma:khma_dev_password@localhost:5432/khma
